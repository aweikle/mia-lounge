---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Hide header on hero-overlay pages? Default false. */
  transparentHeader?: boolean;
}

const {
  title,
  description = `${site.brand} — ${site.tagline}. Photo booth experiences for weddings, parties & events in ${site.serviceArea}.`,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.brand}` : `${site.brand} · ${site.tagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/images/logo/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Allura&family=Cinzel:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/logo/og-image.png" />

    <title>{fullTitle}</title>
  </head>
  <body class="font-body bg-ink text-cream antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .font-script { font-family: var(--font-script); }
  .font-display { font-family: var(--font-display); }
  .font-body { font-family: var(--font-body); }
</style>
