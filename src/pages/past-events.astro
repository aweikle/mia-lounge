---
import Layout from "../layouts/Layout.astro";
import { events } from "../data/events";
---

<Layout title="Past Events" description="Photos and stories from past events Mia Snap Lounge has had the joy of capturing.">
  <section class="relative pt-40 pb-12 sparkle-bg">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-eyebrow mb-4">Memories</p>
      <h1 class="font-script rose-gradient-text text-6xl sm:text-7xl md:text-8xl mb-6" style="font-family: var(--font-script)">
        Past Events
      </h1>
      <div class="glow-divider mb-8"></div>
      <p class="text-lg text-cream-dim leading-relaxed max-w-2xl mx-auto">
        A peek at some of the celebrations we've had the joy of capturing.
        Every booth tells a story — here are a few of our favorites.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6 space-y-24">
      {events.map((event, idx) => (
        <article class="grid lg:grid-cols-12 gap-8 items-center">
          <div class:list={[
            "lg:col-span-7 relative aspect-[4/3] rounded-2xl overflow-hidden border border-ink-line",
            idx % 2 === 1 && "lg:order-2"
          ]}>
            <img
              src={event.cover}
              alt={`Cover photo from ${event.title}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class:list={[
            "lg:col-span-5",
            idx % 2 === 1 && "lg:order-1"
          ]}>
            <p class="section-eyebrow mb-3">{event.date}</p>
            <h2 class="text-4xl rose-gradient-text mb-3">{event.title}</h2>
            <p class="text-rose-300 text-sm mb-5" style="font-family: var(--font-display)">{event.venue}</p>
            <p class="text-cream-dim leading-relaxed mb-6">{event.blurb}</p>

            <div class="grid grid-cols-4 gap-2">
              {event.photos.slice(0, 4).map((photo) => (
                <div class="aspect-square rounded-md overflow-hidden border border-ink-line">
                  <img
                    src={photo}
                    alt={`Moment from ${event.title}`}
                    class="w-full h-full object-cover hover:scale-105 transition duration-500"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl rose-gradient-text mb-6">Yours could be next</h2>
      <p class="text-cream-dim mb-8">Every event we book gets the same level of care, styling, and attention you see here.</p>
      <a href="/booking" class="btn-primary">Reserve Your Date</a>
    </div>
  </section>
</Layout>
