---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { events } from "../data/events";

// Eager-load all event photos so we can pick a cover for each event.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/*/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

// For each event, pick the first photo (alphabetical) as the cover.
const eventCovers = events.map((event) => {
  const match = Object.entries(allImages)
    .filter(([path]) => path.includes(`/src/images/${event.folder}/`))
    .sort(([a], [b]) => a.localeCompare(b))[0];
  return { event, cover: match?.[1].default };
});
---

<Layout title="Past Events" description="Photos and stories from past events Mia Snap Lounge has had the joy of capturing.">
  <section class="relative pt-40 pb-12 sparkle-bg">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-eyebrow mb-4">Memories</p>
      <h1 class="font-script rose-gradient-text text-6xl sm:text-7xl md:text-8xl mb-6" style="font-family: var(--font-script)">
        Past Events
      </h1>
      <div class="glow-divider mb-8"></div>
      <p class="text-lg text-cream-dim leading-relaxed max-w-2xl mx-auto">
        A peek at some of the celebrations we've had the joy of capturing.
        Click any event to see the full gallery.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6 space-y-24">
      {eventCovers.map(({ event, cover }, idx) => (
        <article class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <a
            href={`/events/${event.slug}`}
            class:list={[
              "lg:col-span-7 relative block aspect-[4/3] rounded-2xl overflow-hidden border border-ink-line hover:border-rose-400 transition group",
              idx % 2 === 1 && "lg:order-2",
            ]}
            aria-label={`Open the ${event.title} gallery`}
          >
            {cover ? (
              <Image
                src={cover}
                alt={`Cover photo from ${event.title}`}
                widths={[800, 1200, 1600]}
                sizes="(max-width: 1024px) 100vw, 60vw"
                class="w-full h-full object-cover transition duration-700 group-hover:scale-[1.03]"
                loading={idx === 0 ? "eager" : "lazy"}
              />
            ) : (
              <div class="w-full h-full bg-ink-card flex items-center justify-center text-cream-dim text-sm">
                Photos coming soon
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition"></div>
            <div class="absolute bottom-5 left-5 text-rose-200 text-xs uppercase tracking-[0.3em] opacity-0 group-hover:opacity-100 transition" style="font-family: var(--font-display)">
              View Gallery →
            </div>
          </a>

          <div class:list={["lg:col-span-5", idx % 2 === 1 && "lg:order-1"]}>
            <p class="section-eyebrow mb-3">{event.date}</p>
            <h2 class="text-4xl rose-gradient-text mb-3">
              <a href={`/events/${event.slug}`} class="hover:opacity-80 transition">
                {event.title}
              </a>
            </h2>
            {event.venue && (
              <p class="text-rose-300 text-sm mb-5" style="font-family: var(--font-display)">
                {event.venue}
              </p>
            )}
            <p class="text-cream-dim leading-relaxed mb-6">{event.blurb}</p>
            <a href={`/events/${event.slug}`} class="btn-ghost">
              View Full Gallery
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-4xl rose-gradient-text mb-6">Yours could be next</h2>
      <p class="text-cream-dim mb-8">Every event we book gets the same level of care, styling, and attention you see here.</p>
      <a href="/booking" class="btn-primary">Reserve Your Date</a>
    </div>
  </section>
</Layout>
